[Unit]
Description=Drawingmachine execution service
After=basic.target

[Service]
Type=simple
ExecStart=%h/.local/lib/drawingmachine/venv/bin/drawingmachine service run
Restart=on-failure
RestartSec=2s
UMask=0077
RuntimeDirectory=drawingmachine
RuntimeDirectoryMode=0710
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictSUIDSGID=true
LockPersonality=true
ReadOnlyPaths=%h/.config/drawingmachine @OPENCLAW_REGISTRY_ROOT@
ReadWritePaths=%h/.local/state/drawingmachine %h/.local/share/drawingmachine %t/drawingmachine @OPENCLAW_MANAGED_ROOT@

[Install]
WantedBy=default.target
